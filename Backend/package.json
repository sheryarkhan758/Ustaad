{
  "name": "ustaad",
  "version": "0.1.0",
  "private": true,
  "description": "Ustaad.com — verified tutor discovery, home tuition and matching platform for Pakistan",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/db/seed/index.ts",
    "db:seed:demo": "tsx server/db/seed/demo/index.ts",
    "setup:env": "tsx scripts/setup-env.ts",
    "setup": "npm run setup:env && npm run db:migrate && npm run db:seed && npm run db:seed:demo",
    "db:reset": "npm run db:migrate && npm run db:seed && npm run db:seed:demo",
    "docs:api": "tsx scripts/generate-api-docs.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "lint": "eslint .",
    "schema:pg": "tsx scripts/generate-pg-schema.ts",
    "schema:pg:check": "tsx scripts/generate-pg-schema.ts --check",
    "db:verify": "tsx scripts/verify-row-counts.ts",
    "jobs": "tsx server/jobs/index.ts",
    "bench:search": "tsx scripts/benchmark-search.ts",
    "db:compare": "tsx scripts/compare-row-counts.ts",
    "scan:bundle": "tsx scripts/scan-bundle-secrets.ts --dir ../Frontend/dist",
    "verify:deploy": "tsx scripts/post-deploy-check.ts"
  },
  "dependencies": {
    "@netlify/functions": "^5.3.0",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "postgres": "^3.4.9",
    "serverless-http": "^4.0.0",
    "supertest": "^7.2.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
