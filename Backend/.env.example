# ===========================================================================
# Ustaad.com — environment template
#
# Copy to .env and fill in locally:   cp .env.example .env
# .env is gitignored. .env.example is committed and MUST NEVER contain a real
# value — no key, no password, no connection string, no mailbox. Placeholders
# only, forever. (NFR-4)
# ===========================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development                        # development | production | test
PORT=3000                                   # Express listen port in local dev
APP_VERSION=0.1.0                           # stamped onto platform_feedback rows (FR-32.4)
LOG_LEVEL=info                              # error | warn | info | debug — never log PII at any level

# --- Database (§10.2: SQLite file in dev, Supabase Postgres in production) --
# SUPABASE_DB_URL is THE switch: set it and the process talks to Supabase Postgres;
# leave it unset and it talks to the local SQLite file. See server/db/PORTABILITY.md
# and scripts/migrate-to-supabase.md. Never commit a real connection string.
# SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=file:./local.db                # local SQLite file; ignored when SUPABASE_DB_URL is set
DB_POOL_MAX=5                               # postgres only; suits the Supabase transaction pooler

# --- Supabase (production database + private document bucket) ---------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co          # project URL, production only
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY    # server-side only; never reaches the browser bundle
SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY                    # public key used by the client for nothing privileged
SUPABASE_STORAGE_BUCKET=ustaad-private-documents           # private bucket: CNIC images, degrees, volunteer CVs (SEC-7, FR-33.4)
SIGNED_URL_TTL_SECONDS=300                  # lifetime of an admin document link; keep short (SEC-7, NFR-9)
LOCAL_UPLOAD_DIR=uploads                    # dev only: gitignored fallback when Supabase is unset
PUBLIC_BASE_URL=http://localhost:3000       # base for locally-issued upload/read URLs

# --- Authentication ---------------------------------------------------------
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING   # signs the session JWT; rotate if ever exposed
JWT_EXPIRES_IN=7d                           # session lifetime
COOKIE_NAME=ustaad_session                  # httpOnly cookie carrying the JWT (FR-1.2)
COOKIE_SECURE=false                         # false in local http dev; MUST be true in production
COOKIE_DOMAIN=localhost                     # cookie scope; the deployed domain in production
BCRYPT_COST=12                              # bcrypt cost factor, 10 or above (NFR-3)

# --- Sensitive-field cryptography -------------------------------------------
CNIC_HASH_SALT=REPLACE_WITH_A_LONG_RANDOM_SALT   # salts the CNIC hash used for duplicate detection only (SEC-8, NFR-10)
ADDRESS_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_KEY  # AES key for booking addresses at rest (SEC-3, NFR-18)

# --- AI providers (server-side only — never exposed to the browser, NFR-5) --
AI_PRIMARY_PROVIDER=gemini                  # gemini | groq — adapter selection (§7.5)
AI_FALLBACK_PROVIDER=groq                   # used on rate limit or provider outage
GEMINI_API_KEY=REPLACE_WITH_GOOGLE_AI_STUDIO_KEY   # Google AI Studio free tier
GEMINI_MODEL=gemini-2.0-flash               # primary model identifier, persisted on every AI output row
GROQ_API_KEY=REPLACE_WITH_GROQ_KEY          # Groq free tier
GROQ_MODEL=llama-3.3-70b-versatile          # fallback model identifier
AI_DAILY_CALL_BUDGET=100                    # live calls per UTC day; past it the AI paths degrade to manual (§7.4)
AI_REQUEST_TIMEOUT_MS=15000                 # per-call timeout before failover
# Turn caps are NOT configurable: they are constants in shared/ai-contract.ts
# (AGENT_LIMITS), because a hard cap that a deployment can raise is not a cap.
PROMPTS_DIR=./prompts                       # versioned prompt Markdown loaded at runtime (§7.3)
DEMO_REPLAY=false                           # true replays stored agent sessions with zero live calls (FR-15.x)

# --- EmailJS (SERVER-side dispatch; public identifiers only, SEC-25) --------
# Dispatched from the server, not the browser. FR-33.9 requires the dispatch
# outcome to be recorded against the row, and a browser-side send can only
# report back — which is precisely the silent-loss failure the requirement
# exists to prevent. Nothing here is VITE_-prefixed, so no send-capable
# identifier reaches the client bundle.
EMAILJS_SERVICE_ID=REPLACE_WITH_SERVICE_ID             # EmailJS service id — public by design
EMAILJS_PUBLIC_KEY=REPLACE_WITH_PUBLIC_KEY             # EmailJS public key — public by design
EMAILJS_PRIVATE_KEY=                                   # OPTIONAL EmailJS strict-mode token. NOT a mail password. Leave blank if unused
EMAILJS_TEMPLATE_VOLUNTEER=REPLACE_WITH_TEMPLATE_ID    # volunteer application notification (FR-33.6)
EMAILJS_TEMPLATE_VOLUNTEER_ACK=REPLACE_WITH_TEMPLATE_ID # applicant acknowledgement, same dispatch (FR-33.7)
EMAILJS_TEMPLATE_FEEDBACK=REPLACE_WITH_TEMPLATE_ID     # platform feedback notification (FR-32.9)
MAIL_TIMEOUT_MS=10000                       # per-send timeout; a slow mailer must not hold a submission open
PLATFORM_MAILBOX=team@example.com           # placeholder inbox; there is NO SMTP credential, mail password or private key anywhere in this repository

# --- Abuse controls ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000                 # rolling window for public endpoints
RATE_LIMIT_MAX=100                          # requests per window per IP
AUTH_RATE_LIMIT_WINDOW_MS=900000            # login + register window
AUTH_RATE_LIMIT_MAX=10                      # failed login/register attempts per IP per window
PUBLIC_FORM_RATE_LIMIT_MAX=5                # tighter cap on volunteer + anonymous feedback forms (FR-33.8, FR-32.6)
CORS_ORIGIN=http://localhost:5173           # Vite dev origin; the deployed origin in production

# --- Seed data --------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com          # bootstrap administrator; ADMIN is seed-assignable only (FR-1.5)
SEED_ADMIN_PASSWORD=REPLACE_IN_LOCAL_ENV_ONLY   # local development only; never a real or reused password
